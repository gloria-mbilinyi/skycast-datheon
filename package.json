{
  "name": "skycast-datheon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SkyCast — Weather & Climate Dashboard | Datheon Task 3",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:all": "npm run check && npm test && npm run test:browser",
    "test:live": "node scripts/live-check.mjs",
    "screenshots": "node scripts/live-check.mjs --screenshots"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1"
  }
}
